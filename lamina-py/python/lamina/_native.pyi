"""Native module. Use the typed API in `lamina` instead."""

from typing import Callable

SCHEMA_VERSION: int
ASSUMPTION: str

class LaminaError(Exception): ...
class SchemaError(ValueError): ...
class InvalidInput(ValueError): ...
class UnsupportedTermination(InvalidInput): ...
